# Files the `vercel` CLI must never upload. Production settings come from the Vercel
# project's Environment Variables, not from local .env files.
.env
.env.*
# the template too: the app never reads it, and a key pasted into it by mistake must not ship
# local uploads: production media lives in Supabase Storage
/media
node_modules
.next
.next-*
tsconfig.tsbuildinfo
.vercel
.claude
.agents
data
supabase/.temp
.DS_Store
