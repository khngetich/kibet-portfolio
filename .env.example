# ── Database ─────────────────────────────────────────────
# Local:      postgres://you@localhost:5432/portfolio
# Supabase:   Project → Connect → "Transaction pooler" URI (port 6543), with your DB password
DATABASE_URL=

# Long random string: `openssl rand -hex 32`
PAYLOAD_SECRET=

# The site's public URL (http://localhost:3000 locally, https://your-domain in production)
NEXT_PUBLIC_SERVER_URL=

# ── Media storage (Supabase Storage, S3-compatible) ─────
# Leave empty locally: uploads are saved to ./media instead.
# Supabase: Storage → create a PUBLIC bucket named "media" → Settings → S3 access keys.
S3_BUCKET=media
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=<your project region, e.g. eu-central-1>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the bucket, used to serve images straight from Supabase's CDN
S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media
# Upload big files straight from the browser to the bucket (needed on Vercel, which caps a request
# at ~4.5 MB). Turn on once the bucket's CORS allows PUT from your site's domain.
S3_CLIENT_UPLOADS=false

# ── Email (optional, recommended) ───────────────────────
# Without these, new-enquiry alerts and password resets are only printed to the server log.
# resend.com → API Keys. EMAIL_FROM must be on a domain you verified in Resend
# (onboarding@resend.dev works for testing, but only delivers to your own Resend address).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Portfolio
# Where new-enquiry alerts go. Defaults to Site settings → Email.
NOTIFY_EMAIL=

# ── Spam protection for the contact form (optional, recommended) ──
# Cloudflare dashboard → Turnstile → Add widget (your domain). Both keys, or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Error alerts (optional) ──────────────────────────────
# A Slack or Discord incoming-webhook URL: server errors are posted there as well as logged.
ERROR_WEBHOOK_URL=
