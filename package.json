{
  "name": "designer-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "seed-pages": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed-pages.ts",
    "ci": "payload migrate && npm run build",
    "lint": "eslint .",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "backup": "bash scripts/backup.sh",
    "fix-content": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/fix-content.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/email-resend": "3.90.1",
    "@payloadcms/live-preview-react": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/plugin-seo": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/storage-s3": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "geist": "^1.7.2",
    "graphql": "^16.14.2",
    "motion": "^12.43.0",
    "next": "^16.3.6",
    "payload": "3.90.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "supabase": "^2.117.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true
  },
  "type": "module",
  "overrides": {
    "undici": "^7.30.0",
    "dompurify": "^3.4.13"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
